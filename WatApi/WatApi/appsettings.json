{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=wat_db;Username=postgres;Password=supersecret"
  },
    "RateLimiting": {
      "UseUserId": true,
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "PerRoute": true
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Jwt": {
      "Key": "MYSECRETKEY",
      "Issuer": "WatApiBackend",
      "Audience": "WatApiFrontend"
    },
    "AllowedHosts": "*"
  }
  